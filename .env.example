# Configuration de la base de données
DB_HOST=localhost
DB_NAME=etontine
DB_USER=root
DB_PASSWORD=change_moi
DB_CHARSET=utf8mb4

# URL de l'application
APP_URL=http://localhost/etontine

# Configuration SMTP (envoi d'emails) - laisser vide pour désactiver l'envoi d'emails sans bloquer l'application
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@e-tontine.local
